# Ensure consistent line endings across platforms
* text=auto

# PKGBUILD files must have LF line endings for MSYS2 compatibility
PKGBUILD text eol=lf

# Unified diffs retain context markers on blank lines and require stable line endings
*.patch text eol=lf whitespace=-blank-at-eol

# Shell scripts should have LF line endings
*.sh text eol=lf

# CMake scripts are package sources and their checksums must be platform-stable
*.cmake text eol=lf

# Windows batch files should have CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.tar.gz binary
*.tgz binary
*.zip binary
*.pkg.tar.* binary
