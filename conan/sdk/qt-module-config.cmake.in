# Compatibility entry point for Qt's individual module package names.
# ConanCenter describes these targets in the common Qt6 package.
include(CMakeFindDependencyMacro)
find_dependency(Qt6 CONFIG)
if(TARGET Qt6::@MODULE@)
    set(Qt6@MODULE@_FOUND TRUE)
    set(Qt6@MODULE@_VERSION "${Qt6_VERSION_STRING}")
    set(Qt6@MODULE@_VERSION_STRING "${Qt6_VERSION_STRING}")
    set(Qt6@MODULE@_LIBRARIES Qt6::@MODULE@)
    string(REPLACE "." ";" _workrave_qt_version "${Qt6_VERSION_STRING}")
    list(APPEND _workrave_qt_version 0 0 0)
    list(GET _workrave_qt_version 0 Qt6@MODULE@_VERSION_MAJOR)
    list(GET _workrave_qt_version 1 Qt6@MODULE@_VERSION_MINOR)
    list(GET _workrave_qt_version 2 Qt6@MODULE@_VERSION_PATCH)
    unset(_workrave_qt_version)
else()
    set(Qt6@MODULE@_FOUND FALSE)
    set(Qt6@MODULE@_NOT_FOUND_MESSAGE "Qt6::@MODULE@ is not enabled in this SDK")
endif()
