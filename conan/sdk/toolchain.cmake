# Native Windows llvm-mingw, using the exported Conan CMakeDeps metadata.
set(WORKRAVE_SDK_DIR "${CMAKE_CURRENT_LIST_DIR}" CACHE PATH "Conan dependency SDK")
file(TO_CMAKE_PATH "$ENV{LLVM_MINGW_ROOT}" LLVM_MINGW_ROOT)
set(CMAKE_C_COMPILER "${LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang.exe")
set(CMAKE_CXX_COMPILER "${LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang++.exe")
set(CMAKE_RC_COMPILER "${LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-windres.exe")
set(CMAKE_ASM_MASM_COMPILER "${LLVM_MINGW_ROOT}/bin/llvm-ml.exe")
set(CMAKE_ASM_MASM_FLAGS "--m64")
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_SCAN_FOR_MODULES OFF)
set(CMAKE_MAP_IMPORTED_CONFIG_RELEASE RelWithDebInfo Release "")
set(CMAKE_MAP_IMPORTED_CONFIG_DEBUG RelWithDebInfo Release "")
set(SYS_ROOT "${LLVM_MINGW_ROOT}/x86_64-w64-mingw32" CACHE PATH "Compiler runtime")
file(GLOB sdk_packages LIST_DIRECTORIES TRUE "${WORKRAVE_SDK_DIR}/packages/*")
list(PREPEND CMAKE_PREFIX_PATH "${WORKRAVE_SDK_DIR}/generators" ${sdk_packages})
set(CMAKE_FIND_PACKAGE_PREFER_CONFIG ON)
set(CMAKE_C_FLAGS_RELEASE_INIT "-O3 -DNDEBUG -g -gcodeview")
set(CMAKE_CXX_FLAGS_RELEASE_INIT "-O3 -DNDEBUG -g -gcodeview")
set(CMAKE_C_FLAGS_DEBUG_INIT "-g -gcodeview")
set(CMAKE_CXX_FLAGS_DEBUG_INIT "-g -gcodeview")
